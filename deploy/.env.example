# 复制为 deploy/.env 后生效（该文件不入 Git）
# 首次运行可用 deploy/scripts/up.ps1 自动生成随机值

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=please-change-root
MYSQL_DATABASE=smartpool
MYSQL_USER=smartpool
MYSQL_PASSWORD=please-change-user

# ---------- 鉴权 ----------
JWT_SECRET=please-change-to-a-random-32-bytes-string

# ---------- 推理服务 ----------
# mock（占位实现，默认）或 mamba-yolo（需自行准备权重与 GPU 环境）
AI_DETECTOR_PROVIDER=mock
AI_DEVICE=cpu
# 权重路径，仅在 AI_DETECTOR_PROVIDER=mamba-yolo 时需要
AI_MODEL_PATH=

# ---------- 实时画面（可选） ----------
# 留空则不启用 MJPEG 推流，前端使用合成画面
# 可填容器内路径 /app/artifacts/demo.mp4、rtsp://... 或 0（本机摄像头索引）
AI_VIDEO_SOURCE=
AI_VIDEO_STRIDE=5
AI_STREAM_MAX_WIDTH=960
